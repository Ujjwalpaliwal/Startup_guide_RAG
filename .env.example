QDRANT_URL=https://your-cluster-url.qdrant.io:6333
QDRANT_API_KEY=your-api-key
QDRANT_COLLECTION_NAME=startup_docs
GROQ_API_KEY=your-groq-api-key
# Optional: Groq speech-to-text model used by POST /api/transcribe
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Local fallback (used automatically when the cloud cluster is unreachable)
QDRANT_MODE=auto
QDRANT_LOCAL_URL=http://localhost:6333
# Only set this if you configured an API key on the local Qdrant instance.
QDRANT_LOCAL_API_KEY=
